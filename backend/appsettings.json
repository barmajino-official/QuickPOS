{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "ExpiryHours": 8,
    "DevAuthToken": "dev-only-token-change-me"
  },
  "Uploads": {
    "Path": "./uploads",
    "MaxBytes": 10485760
  }
}
