{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css:watch": "tailwindcss -i ./src/index.css -o ./src/output.css --watch",
    "dev": "bun --hot src/index.ts",
    "build": "tailwindcss -i ./src/index.css -o ./src/output.css --minify && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "daisyui": "^5.5.19",
    "framer-motion": "^12.38.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.14.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.4",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.2.4"
  }
}
